{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "hypothesis",
    "cohort",
    "data_cutoff",
    "primary_metric",
    "baseline",
    "min_games",
    "promotion_criterion",
    "failure_outcome",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]+-.*$"
    },
    "title": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "cohort": {
      "type": "string",
      "enum": ["exploration", "confirmation"]
    },
    "data_cutoff": {
      "type": "string",
      "format": "date"
    },
    "primary_metric": {
      "type": "string"
    },
    "baseline": {
      "type": "object",
      "required": ["fit_id", "commit"],
      "properties": {
        "fit_id": {
          "type": "integer"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "selection_folds": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "min_games": {
      "type": "integer"
    },
    "expected_effect": {
      "type": "number"
    },
    "promotion_criterion": {
      "type": "string"
    },
    "failure_outcome": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["registered", "rejected", "inconclusive", "promoted"]
    },
    "result": {
      "type": ["object", "null"],
      "properties": {
        "games": {
          "type": "integer"
        },
        "difference": {
          "type": "number"
        },
        "interval": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "csv_path": {
          "type": "string"
        },
        "csv_hash": {
          "type": "string"
        }
      }
    }
  }
}

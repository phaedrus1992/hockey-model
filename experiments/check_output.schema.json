{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ok", "records", "errors"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "valid"],
        "properties": {
          "id": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "has_result": {
            "type": "boolean"
          },
          "registration_commit": {
            "type": "string"
          },
          "immutability": {
            "type": "string"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
